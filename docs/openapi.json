          "fileName": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "description": "Original file name"
          },
          "mimeType": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Mimetype",
            "description": "Declared media type verified before use"
          },
          "fileData": {
            "type": "string",
            "minLength": 1,
            "title": "Filedata",
            "description": "Base64-encoded file bytes"
          },
          "attachmentType": {
            "$ref": "#/components/schemas/AttachmentType",
            "default": "unknown"
          },
          "fileSizeBytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
