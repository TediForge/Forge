            "pattern": "^A[A-Z0-9]{5}$",
            "title": "Actionid"
          },
          "actionType": {
            "type": "string",
            "enum": [
              "tool",
              "integration",
              "data",
              "attachment"
            ],
            "title": "Actiontype"
          },
          "toolName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Toolname"
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "processing",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "message": {
            "type": "string",
