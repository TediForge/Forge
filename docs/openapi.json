              },
              {
                "type": "null"
              }
            ],
            "title": "Snippet"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "web",
              "document",
              "integration",
              "other"
            ],
            "title": "Sourcetype",
            "default": "other"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "SourceReference"
      },
      "SpeechRequest": {
        "properties": {
          "input": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Input"
          },
          "model": {
            "type": "string",
            "const": "forge-tts",
            "title": "Model",
            "default": "forge-tts"
          },
          "voice": {
            "type": "string",
            "const": "default",
            "title": "Voice",
            "default": "default"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "wav",
              "pcm"
            ],
            "title": "Response Format",
            "default": "wav"
          },
          "speed": {
            "type": "number",
            "maximum": 4.0,
            "minimum": 0.25,
            "title": "Speed",
            "default": 1.0
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input"
        ],
        "title": "SpeechRequest"
      },
      "Thought": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[A-Z0-9]{5}$",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "const": "thought",
            "title": "Type",
            "default": "thought"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "processing",
              "completed"
            ],
            "title": "Status",
            "default": "processing"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "id",
          "message"
        ],
        "title": "Thought"
      },
      "UnifiedOrchestratorResponse": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid",
            "description": "Unique execution run identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "requires_action",
              "failed"
            ],
            "title": "Status",
            "default": "completed"
          },
          "functionCalls": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FunctionCall"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Functioncalls"
          },
          "events": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Thought"
                },
                {
                  "$ref": "#/components/schemas/ActionRecord"
                },
                {
                  "$ref": "#/components/schemas/RunStatus"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "action": "#/components/schemas/ActionRecord",
                  "status": "#/components/schemas/RunStatus",
                  "thought": "#/components/schemas/Thought"
                }
              }
            },
            "type": "array",
            "title": "Events"
          },
          "content": {
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            },
            "type": "array",
            "title": "Content"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceReference"
            },
            "type": "array",
            "title": "Sources"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "runId"
        ],
        "title": "UnifiedOrchestratorResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
