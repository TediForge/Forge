# Trusted deployment storage. Mount this path on persistent storage for resume.
FORGE_CHECKPOINT_ROOT=data/checkpoints
FORGE_ENVIRONMENT=development
FORGE_MODEL_CACHE_DIR=data/models
FORGE_AUDIT_LOG_PATH=logs/forge-audit.jsonl

# Optional OpenTelemetry collector endpoint (HTTP/protobuf).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Media is emitted as bounded base64-inline blocks; fetched URLs must be allowlisted.
FORGE_MEDIA_MAX_BYTES=20971520
# FORGE_MEDIA_ALLOWED_HOSTS=cdn.example.com,assets.example.org
FORGE_ATTACHMENT_MAX_BYTES=10485760

# Optional Hugging Face Hub credential for downloading private model weights.
HF_TOKEN=

# Trajectory export is off by default and requires trajectoryExport=true on
# /v1/responses. Records are versioned, bounded, and redacted for common secrets/PII.
FORGE_TRAJECTORY_EXPORT_ENABLED=false
FORGE_TRAJECTORY_EXPORT_DIR=logs/trajectories

# Optional one-way upload of local JSONL files to Hugging Face.
FORGE_HF_SYNC_ENABLED=false
FORGE_HF_TOKEN=
FORGE_HF_REPO_ID=
FORGE_HF_REPO_TYPE=dataset
